# ==========================================================
# .env.example
# 用法：cp .env.example .env，然后把 CHANGE_ME 改掉
#
# 注意：PHP_PM_* 这几个改了必须 docker compose up -d --build
#       光 restart 不生效（踩过坑，见 03-踩坑笔记 第 7 条）
# ==========================================================

# ---------- 数据库 ----------
DB_NAME=demo
DB_USER=app
DB_PASS=CHANGE_ME
DB_ROOT_PASS=CHANGE_ME
# 2G 内存的机器给 128M 合适，别照抄网上的 1G
DB_BUFFER_POOL=128M

# ---------- PHP-FPM ----------
# 2C2G 的机器上 12 是试出来的：8 太小会排队，16 内存会紧
PHP_PM_MAX_CHILDREN=12
PHP_PM_START_SERVERS=3
PHP_PM_MIN_SPARE=2
PHP_PM_MAX_SPARE=6

# ---------- 网络 ----------
# 三台机器的网段
LAN_SUBNET=192.168.86.0/24

# web1 和 web2 的 IP
WEB1_IP=192.168.86.7
WEB2_IP=192.168.86.8

# Zabbix Server 的 IP
ZABBIX_IP=192.168.86.62

# 虚拟 IP（VIP），平时在 web1 上，web1 挂了飘到 web2
# 这个 IP 必须没人用，且在 LAN_SUBNET 网段里
VIP=192.168.86.100

# 网卡名，用 ip a 看。CentOS 7 一般是 ens33，Ubuntu 可能是 ens33 或 enp0s3
NIC=ens33

# ---------- Keepalived ----------
# 两台必须一样，最长 8 位
VRRP_PASS=CHANGE_ME

# 主备优先级，数字大的是主。两台要差 10 以上
KEEPALIVED_PRIO_MASTER=150
KEEPALIVED_PRIO_BACKUP=140

# ---------- 时区 ----------
TZ=Asia/Shanghai
